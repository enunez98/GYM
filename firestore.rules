rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function validUser() {
      return request.resource.data.keys().hasAll([
          'rut', 'name', 'role', 'isActive', 'email', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.rut is string
        && request.resource.data.rut.size() <= 12
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['admin', 'student']
        && request.resource.data.isActive is bool;
    }

    function validStudent() {
      return request.resource.data.keys().hasAll([
          'userId', 'name', 'rut', 'phone', 'email', 'plan', 'contractPeriod',
          'paymentMethod', 'status', 'startDate', 'endDate', 'daysRemaining',
          'weeklyAttendanceCompleted', 'weeklyAttendanceTarget',
          'monthlyAttendanceCompleted', 'monthlyAttendanceTarget', 'bodyScore',
          'currentWeekLabel', 'currentWeekDates', 'createdAtEpoch'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.rut is string
        && request.resource.data.rut.size() >= 2
        && request.resource.data.rut.size() <= 12
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.plan in [
          'Plan 2 sesiones', 'Plan 3 sesiones', 'Plan 4 sesiones'
        ]
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.daysRemaining is int
        && request.resource.data.daysRemaining >= 0
        && request.resource.data.weeklyAttendanceCompleted is int
        && request.resource.data.weeklyAttendanceCompleted >= 0
        && request.resource.data.weeklyAttendanceTarget is int
        && request.resource.data.weeklyAttendanceTarget >= 0
        && request.resource.data.monthlyAttendanceCompleted is int
        && request.resource.data.monthlyAttendanceCompleted >= 0
        && request.resource.data.monthlyAttendanceTarget is int
        && request.resource.data.monthlyAttendanceTarget >= 0
        && request.resource.data.bodyScore is int
        && request.resource.data.bodyScore >= 0
        && request.resource.data.bodyScore <= 100;
    }

    function validEvaluation() {
      return request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.studentProfileId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.bodyScore is int
        && request.resource.data.bodyScore >= 1
        && request.resource.data.bodyScore <= 100
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg >= 20
        && request.resource.data.weightKg <= 400
        && request.resource.data.heightCm is number
        && request.resource.data.heightCm >= 80
        && request.resource.data.heightCm <= 250
        && request.resource.data.bodyFatPercent is number
        && request.resource.data.bodyFatPercent >= 1
        && request.resource.data.bodyFatPercent <= 75
        && request.resource.data.bodyWaterPercent is number
        && request.resource.data.bodyWaterPercent >= 20
        && request.resource.data.bodyWaterPercent <= 80
        && request.resource.data.muscleMassKg is number
        && request.resource.data.muscleMassKg > 0
        && request.resource.data.muscleMassKg <= request.resource.data.weightKg;
    }

    function validRoutine() {
      return request.resource.data.plan in [
          'Plan 2 sesiones', 'Plan 3 sesiones', 'Plan 4 sesiones'
        ]
        && request.resource.data.sourceFileName is string
        && request.resource.data.sourceFileName.size() <= 255
        && request.resource.data.sessions is list
        && request.resource.data.sessions.size() > 0
        && request.resource.data.sessions.size() <= 208;
    }

    function validAssignment(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.studentProfileId is string
        && request.resource.data.plan in [
          'Plan 2 sesiones', 'Plan 3 sesiones', 'Plan 4 sesiones'
        ]
        && request.resource.data.sessions is list
        && request.resource.data.sessions.size() > 0
        && request.resource.data.sessions.size() <= 208;
    }

    function validWorkout() {
      return request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.studentProfileId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status in ['completed', 'skipped']
        && request.resource.data.exercises is list
        && request.resource.data.exercises.size() <= 100
        && (request.resource.data.status == 'skipped'
          || request.resource.data.exercises.size() > 0);
    }

    function validProgress(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.studentProfileId is string
        && request.resource.data.weekLabel is string
        && request.resource.data.currentSessionIndex is int
        && request.resource.data.currentSessionIndex >= 0
        && request.resource.data.currentSessionIndex <= 52
        && request.resource.data.completedSessionIndexes is list
        && request.resource.data.completedSessionIndexes.size() <= 52
        && request.resource.data.skippedSessionIndexes is list
        && request.resource.data.skippedSessionIndexes.size() <= 52;
    }

    match /users/{userId} {
      allow create: if (isAdmin() && validUser())
        || (signedIn()
          && request.auth.uid == userId
          && request.auth.token.email == 'admin@live.cl'
          && request.resource.data.role == 'admin'
          && validUser());
      allow read: if isAdmin()
        || (isActiveUser() && request.auth.uid == userId);
      allow update: if (isAdmin() && validUser())
        || (isActiveUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name'])
          && validUser());
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validStudent();
      allow delete: if isAdmin();
      allow read: if isActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    match /studentRuts/{normalizedRut} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/studentRuts/$(normalizedRut))
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.studentProfileId is string
        && request.resource.data.studentProfileId.size() > 0;
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validEvaluation();
      allow delete: if isAdmin();
      allow read: if isActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    match /routines/{routineId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validRoutine();
      allow delete: if isAdmin();
      allow read: if isActiveUser();
    }

    match /routineAssignments/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validAssignment(userId);
      allow delete: if isAdmin();
      allow read: if isActiveUser() && userId == request.auth.uid;
    }

    match /workouts/{workoutId} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && validWorkout();
      allow delete: if isAdmin();
    }

    match /workoutProgress/{progressId} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create: if isActiveUser()
        && validProgress(request.auth.uid);
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && validProgress(request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
